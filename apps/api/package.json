{
  "name": "@onlytools/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/scheduled.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --out-extension:.js=.mjs --external:@aws-sdk/*",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.1171.0",
    "@aws-sdk/client-cloudwatch": "^3.1171.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1171.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1137.0",
    "@aws-sdk/client-cost-explorer": "^3.1171.0",
    "@aws-sdk/client-dynamodb": "^3.1171.0",
    "@aws-sdk/client-sts": "^3.1171.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
